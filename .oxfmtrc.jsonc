{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "experimentalSortImports": {
    "newlinesBetween": false,
  },
  "experimentalSortPackageJson": {
    "sortScripts": true,
  },
  "ignorePatterns": [
    "apps/",
    "assets/",
    "dist/",
    "docs/_layouts/",
    "node_modules/",
    "openapi/",
    "packages/client/src/generated/",
    "packages/legacy-analyzer/examples/",
    "patches/",
    // Import bundles whose manifests carry SHA-256 hashes of these exact bytes.
    "src/industrial/vendor-import/test-fixtures/",
    "pnpm-lock.yaml/",
    "Swabble/",
    "vendor/",
  ],
}
