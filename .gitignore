# --- fleet-ignore correction, 2026-08-05 ---
# The fleet ignore carries models/ and sessions/ to keep model weights and
# runtime state out of git. In THIS repo those are also source directory names
# (src/commands/models, src/config/sessions), and the patterns were silently
# swallowing real source. Nothing under src/ is ever generated state.
!src/**

# private overlay: Anthropic OAuth login command stays outside the repository (build no longer needs it)
src/commands/models/auth-anthropic-oauth.ts

# prebuilt release bundles (scripts/bundle.mjs)
release/
release-out/

# operator overlay: family and internal material, never part of the product tree (see private/README.md)
private/
.claude/worktrees/
src/canvas-host/a2ui/a2ui.bundle.js
src/canvas-host/a2ui/.bundle.hash

# continuity suite default output dir (kolo continuity run --out)
continuity-out/
