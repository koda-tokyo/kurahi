{
  "$comment": "Hand-maintained provider entries (KoLo 2.0, M9c/M10). These come first in registry.json, in this order, and win over the public catalogue. Entries are configuration identifiers, never product copy. Regenerate registry.json with: pnpm providers:sync",
  "version": 1,
  "providers": [
    {
      "id": "sakura",
      "displayName": "Sakura AI Engine",
      "apiStyle": "openai-compatible",
      "baseUrl": "https://api.ai.sakura.ad.jp/v1",
      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Hosted in Japan",
      "defaultModel": "gpt-oss-120b",
      "envVar": "SAKURA_API_KEY",
      "recommended": true,
      "pricing": {
        "currency": "JPY",
        "asOf": "2026-10-14",
        "source": "https://ai.sakura.ad.jp/sakura-ai/ai-engine/",
        "note": "Pay-as-you-go list price, tax included; published per 10,000 tokens. Preview models may change.",
        "models": {
          "gpt-oss-120b": {
            "input": 15,
            "output": 75
          },
          "llm-jp-3.1-8x13b-instruct4": {
            "input": 15,
            "output": 75
          },
          "Qwen3.6-35B-A3B": {
            "input": 30,
            "output": 150
          },
          "gemma-4-31B-it": {
            "input": 24,
            "output": 96
          },
          "Kimi-K2.6": {
            "input": 60,
            "output": 300
          }
        }
      }
    },
    {
      "id": "openai-compatible",
      "displayName": "OpenAI-compatible endpoint",
      "apiStyle": "openai-compatible",
      "baseUrl": "",
      "authHeader": "bearer",
      "modelsEndpoint": "/models",
      "regionNote": "Wherever the endpoint you give is hosted",
