{
  "name": "@KoLo/mattermost",
  "version": "2.1.0",
  "description": "Kurahi Mattermost channel plugin",
  "type": "module",
  "devDependencies": {
    "kolo": "workspace:kurahi@*"
  },
  "KoLo": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "mattermost",
      "label": "Mattermost",
      "selectionLabel": "Mattermost (plugin)",
      "docsPath": "/channels/mattermost",
      "docsLabel": "mattermost",
      "blurb": "self-hosted Slack-style chat; install the plugin to enable.",
      "order": 65
    },
    "install": {
      "npmSpec": "@KoLo/mattermost",
      "localPath": "extensions/mattermost",
      "defaultChoice": "npm"
    }
  }
}
