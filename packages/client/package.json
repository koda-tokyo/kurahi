{
  "name": "@kodasoken/kurahi-client",
  "version": "2.2.0",
  "description": "Typed client for the KoLo gateway HTTP and WebSocket API, generated from its OpenAPI 3.1 document.",
  "license": "MIT",
  "author": "Carlos Mundim (KODA)",
  "files": [
    "LICENSE",
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  }
}
