{
  "name": "kurahi",
  "version": "2.0.3",
  "description": "Kurahi: a resident agent runtime. One service per identity; terminal, web, messaging and paired devices are its clients.",
  "keywords": [
    "agent",
    "assistant",
    "automation",
    "cli",
    "gateway",
    "multi-channel"
  ],
  "homepage": "https://kodasoken.com/kolo",
  "bugs": {
    "url": "https://github.com/koda-tokyo/kurahi/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "KODA Group",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koda-tokyo/kurahi.git"
  },
  "bin": {
    "kolo": "kolo.mjs",
    "kurahi": "kolo.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "kolo.mjs",
    "README.md",
    "assets/**",
    "docs/**",
    "extensions/**",
    "git-hooks/**",
    "patches/**",
    "scripts/format-staged.js",
    "scripts/postinstall.js",
    "scripts/setup-git-hooks.js",
    "skills/**",
    "dist/**",
    "!dist/test-helpers/**",
    "!dist/test-utils/**",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map",
    "LICENSING.md",
    "LICENSES/**",
    "NOTICE",
    "ATTRIBUTION.md",
    "TRADEMARKS.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugin-sdk": "./dist/plugin-sdk/index.js",
    "./plugin-sdk/*": "./dist/plugin-sdk/*",
    "./cli-entry": "./kolo.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "KoLo": "node scripts/run-node.mjs",
    "Kurahi:rpc": "node scripts/run-node.mjs agent --mode rpc --json",
    "android:assemble": "cd apps/android && ./gradlew :app:assembleDebug",
    "android:install": "cd apps/android && ./gradlew :app:installDebug",
    "android:run": "cd apps/android && ./gradlew :app:installDebug && adb shell am start -n ai.kolo.android/.MainActivity",
    "android:test": "cd apps/android && ./gradlew :app:testDebugUnitTest",
    "build": "pnpm canvas:a2ui:bundle && pnpm client:build && tsc -p tsconfig.json --noEmit false && node --import tsx scripts/canvas-a2ui-copy.ts && node --import tsx scripts/copy-hook-metadata.ts && node --import tsx scripts/write-build-info.ts && node --import tsx scripts/protocol-gen.ts && node --import tsx scripts/openapi-gen.mjs && node --import tsx scripts/dist-freeze.ts generate",
    "canvas:a2ui:bundle": "node scripts/bundle-a2ui.mjs",
    "channels:check": "node scripts/channels-check.mjs",
    "check": "pnpm client:build && pnpm tsgo && pnpm lint && pnpm format && pnpm openapi:check && pnpm client:check",
    "check:loc": "node --import tsx scripts/check-ts-max-loc.ts --max 500",
    "client:build": "tsc -p packages/client/tsconfig.json",
    "client:check": "node scripts/client-gen.mjs --check",
    "client:gen": "node scripts/client-gen.mjs",
    "continuity:check": "node scripts/continuity-check.mjs",
    "dev": "node scripts/run-node.mjs",
    "docs:bin": "node scripts/build-docs-list.mjs",
    "docs:build": "cd docs && pnpm dlx --reporter append-only mint broken-links",
    "docs:dev": "cd docs && mint dev",
    "docs:list": "node scripts/docs-list.js",
    "evidence:check": "node scripts/evidence-check.mjs",
    "factory:check": "node scripts/factory-check.mjs",
    "format": "oxfmt --check",
    "format:all": "pnpm format && pnpm format:swift",
    "format:fix": "oxfmt --write",
    "format:swift": "swiftformat --lint --config .swiftformat apps/macos/Sources apps/ios/Sources apps/shared/KoLoKit/Sources",
    "gateway:dev": "KOLO_SKIP_CHANNELS=1 node scripts/run-node.mjs --dev gateway",
    "gateway:dev:reset": "KOLO_SKIP_CHANNELS=1 node scripts/run-node.mjs --dev gateway --reset",
    "gateway:watch": "node scripts/watch-node.mjs gateway --force",
    "ios:build": "bash -lc 'cd apps/ios && xcodegen generate && xcodebuild -project KoLo.xcodeproj -scheme Kurahi -destination \"${IOS_DEST:-platform=iOS Simulator,name=iPhone 17}\" -configuration Debug build'",
    "ios:gen": "cd apps/ios && xcodegen generate",
    "ios:open": "cd apps/ios && xcodegen generate && open KoLo.xcodeproj",
    "ios:run": "bash -lc 'cd apps/ios && xcodegen generate && xcodebuild -project KoLo.xcodeproj -scheme Kurahi -destination \"${IOS_DEST:-platform=iOS Simulator,name=iPhone 17}\" -configuration Debug build && xcrun simctl boot \"${IOS_SIM:-iPhone 17}\" || true && xcrun simctl launch booted ai.kolo.ios'",
    "lint": "oxlint --type-aware --tsconfig tsconfig.oxlint.json",
    "lint:all": "pnpm lint && pnpm lint:swift",
    "lint:fix": "oxlint --type-aware --tsconfig tsconfig.oxlint.json --fix && pnpm format:fix",
    "lint:swift": "swiftlint lint --config .swiftlint.yml && (cd apps/ios && swiftlint lint --config .swiftlint.yml)",
    "mac:open": "open dist/KoLo.app",
    "mac:package": "bash scripts/package-mac-app.sh",
    "mac:restart": "bash scripts/restart-mac.sh",
    "openapi:check": "node --import tsx scripts/openapi-check.mjs",
    "openapi:gen": "node --import tsx scripts/openapi-gen.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "plugins:sync": "node --import tsx scripts/sync-plugin-versions.ts",
    "policy:check": "node scripts/policy-check.mjs",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "pnpm build && pnpm ui:build",
    "privacy:check": "node scripts/privacy-check.mjs",
    "protocol:check": "pnpm protocol:gen && pnpm protocol:gen:swift && git diff --exit-code -- dist/protocol.schema.json apps/macos/Sources/KoLoProtocol/GatewayModels.swift",
    "protocol:divergence": "node --import tsx scripts/protocol-divergence.ts check",
    "protocol:gen": "node --import tsx scripts/protocol-gen.ts",
    "protocol:gen:swift": "node --import tsx scripts/protocol-gen-swift.ts",
    "protocol:snapshot": "node --import tsx scripts/protocol-divergence.ts snapshot",
    "providers:check": "node scripts/providers-sync.mjs --check",
    "providers:sync": "node scripts/providers-sync.mjs",
    "release:check": "node --import tsx scripts/release-check.ts",
    "smoke": "node scripts/smoke-gateway.mjs",
    "start": "node scripts/run-node.mjs",
    "test": "node scripts/test-parallel.mjs",
    "test:all": "pnpm lint && pnpm build && pnpm test && pnpm test:e2e && pnpm test:live && pnpm test:docker:all",
    "test:coverage": "vitest run --coverage",
    "test:docker:all": "pnpm test:docker:live-models && pnpm test:docker:live-gateway && pnpm test:docker:onboard && pnpm test:docker:gateway-network && pnpm test:docker:qr && pnpm test:docker:doctor-switch && pnpm test:docker:plugins && pnpm test:docker:cleanup",
    "test:docker:cleanup": "bash scripts/test-cleanup-docker.sh",
    "test:docker:doctor-switch": "bash scripts/e2e/doctor-install-switch-docker.sh",
    "test:docker:gateway-network": "bash scripts/e2e/gateway-network-docker.sh",
    "test:docker:live-gateway": "bash scripts/test-live-gateway-models-docker.sh",
    "test:docker:live-models": "bash scripts/test-live-models-docker.sh",
    "test:docker:onboard": "bash scripts/e2e/onboard-docker.sh",
    "test:docker:plugins": "bash scripts/e2e/plugins-docker.sh",
    "test:docker:qr": "bash scripts/e2e/qr-import-docker.sh",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:force": "node --import tsx scripts/test-force.ts",
    "test:install:e2e": "bash scripts/test-install-sh-e2e-docker.sh",
    "test:install:e2e:anthropic": "KOLO_E2E_MODELS=anthropic bash scripts/test-install-sh-e2e-docker.sh",
    "test:install:e2e:openai": "KOLO_E2E_MODELS=openai bash scripts/test-install-sh-e2e-docker.sh",
    "test:install:smoke": "bash scripts/test-install-sh-docker.sh",
    "test:live": "KOLO_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "test:ui": "pnpm --dir ui test",
    "test:watch": "vitest",
    "tui": "node scripts/run-node.mjs tui",
    "tui:dev": "KOLO_PROFILE=dev node scripts/run-node.mjs --dev tui",
    "ui:build": "node scripts/ui.js build",
    "ui:dev": "node scripts/ui.js dev",
    "ui:install": "node scripts/ui.js install",
    "verify:builds": "node --import tsx scripts/verify-builds.ts",
    "verify:builds:dry": "node --import tsx scripts/verify-builds.ts --dry-run"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.13.1",
    "@aws-sdk/client-bedrock": "^3.980.0",
    "@buape/carbon": "0.14.0",
    "@clack/prompts": "^1.0.0",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@homebridge/ciao": "^1.3.4",
    "@kodasoken/kurahi-client": "workspace:*",
    "@line/bot-sdk": "^10.6.0",
    "@lydell/node-pty": "1.2.0-beta.3",
    "@mariozechner/pi-agent-core": "0.51.0",
    "@mariozechner/pi-ai": "0.51.0",
    "@mariozechner/pi-coding-agent": "0.51.0",
    "@mariozechner/pi-tui": "0.51.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@sinclair/typebox": "0.34.48",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.13.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "ajv": "^8.18.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "discord-api-types": "^0.38.38",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "file-type": "^21.3.0",
    "grammy": "^1.39.3",
    "hono": "4.11.10",
    "jiti": "^2.6.1",
    "json5": "^2.2.3",
    "jszip": "^3.10.1",
    "linkedom": "^0.18.12",
    "long": "^5.3.2",
    "markdown-it": "^14.1.1",
    "node-edge-tts": "^1.2.9",
    "osc-progress": "^0.3.0",
    "pdfjs-dist": "^5.4.624",
    "playwright-core": "1.58.1",
    "postgres": "^3.4.8",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.34.5",
    "signal-utils": "^0.21.1",
    "sqlite-vec": "0.1.7-alpha.2",
    "tar": "7.5.8",
    "tslog": "^4.10.2",
    "undici": "^7.20.0",
    "ws": "^8.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@grammyjs/types": "^3.23.0",
    "@lit-labs/signals": "^0.2.0",
    "@lit/context": "^1.1.6",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "7.0.0-dev.20260201.1",
    "@vitest/coverage-v8": "^4.0.18",
    "lit": "^3.3.2",
    "ollama": "^0.6.3",
    "oxfmt": "0.27.0",
    "oxlint": "^1.42.0",
    "oxlint-tsgolint": "^0.11.4",
    "rolldown": "1.0.0-rc.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^0.1.89",
    "node-llama-cpp": "3.15.1"
  },
  "overrides": {
    "tar": "7.5.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "minimumReleaseAge": 2880,
    "overrides": {
      "fast-xml-parser": "5.3.6",
      "form-data": "2.5.4",
      "@hono/node-server>hono": "4.11.10",
      "hono": "4.11.10",
      "qs": "6.14.2",
      "@sinclair/typebox": "0.34.47",
      "tar": "7.5.8",
      "tough-cookie": "4.1.3",
      "axios": ">=1.13.5",
      "minimatch": ">=10.2.1",
      "@isaacs/brace-expansion": ">=5.0.1",
      "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "basic-ftp@<5.2.0": ">=5.2.0",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "ajv@<6.14.0": ">=6.14.0",
      "hono@<4.12.4": ">=4.12.4",
      "dompurify@>=3.1.3 <=3.3.1": ">=3.3.2",
      "fast-xml-parser@>=5.0.0 <5.3.8": ">=5.3.8",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "tar@<=7.5.9": ">=7.5.10",
      "simple-git@>=3.15.0 <3.32.3": ">=3.32.3",
      "file-type@>=13.0.0 <21.3.1": ">=21.3.1",
      "tar@<=7.5.10": ">=7.5.11",
      "hono@<4.12.7": ">=4.12.7",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "file-type@>=20.0.0 <=21.3.1": ">=21.3.2",
      "undici@>=7.17.0 <7.24.0": ">=7.24.0"
    },
    "onlyBuiltDependencies": [
      "@lydell/node-pty",
      "@matrix-org/matrix-sdk-crypto-nodejs",
      "@napi-rs/canvas",
      "@whiskeysockets/baileys",
      "authenticate-pam",
      "esbuild",
      "node-llama-cpp",
      "protobufjs",
      "sharp"
    ]
  },
  "vitest": {
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "lcov"
      ],
      "thresholds": {
        "lines": 70,
        "functions": 70,
        "branches": 70,
        "statements": 70
      },
      "include": [
        "src/**/*.ts"
      ],
      "exclude": [
        "src/**/*.test.ts"
      ]
    },
    "include": [
      "src/**/*.test.ts"
    ],
    "exclude": [
      "dist/**",
      "apps/macos/**",
      "apps/macos/.build/**",
      "**/vendor/**",
      "apps/macos/.build/**",
      "dist/KoLo.app/**"
    ]
  }
}
